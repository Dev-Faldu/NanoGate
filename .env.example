# NanoGate configuration. Copy to .env (git-ignored). Never commit real credentials.

# --- modes ---------------------------------------------------------------------
APP_MODE=production            # production | demo (reproducible execution profile — same real pipeline)
TELEMETRY_MODE=real            # real | demo (demo marks every value "Demo telemetry" in the UI)
REMOTE_MODE=disabled           # disabled | mock ("Simulated larger tier", served locally) | live | outage-test

# --- local inference (vLLM on the GB10; any OpenAI-compatible endpoint works) --------
# vLLM serves one model per process: scripts/runtime.sh starts one server per tier.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
LOCAL_MODEL_API_KEY=
LOCAL_MODEL_FAMILY=qwen2.5
LOCAL_MODEL_REVISION=auto      # auto = Hugging Face commit sha of the served weights
LOCAL_LARGE_MODEL_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_LARGE_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct
LOCAL_MODEL_TIMEOUT_S=120
MAX_CONCURRENT_INFERENCE=4
MAX_QUEUE_DEPTH=32

# --- vLLM servers (scripts/runtime.sh) ---------------------------------------------------
VLLM_LOCAL_PORT=8000
VLLM_LARGE_PORT=8001
VLLM_LOCAL_GPU_UTIL=0.15       # share of GB10 unified memory for weights + KV cache
VLLM_LARGE_GPU_UTIL=0.40
VLLM_MAX_MODEL_LEN=8192

# --- optional live remote provider (only used when policy + data class permit) ----
REMOTE_PROVIDER=openai
REMOTE_BASE_URL=
REMOTE_API_KEY=
REMOTE_MODEL=gpt-4.1-mini
REMOTE_TIMEOUT_S=20

# --- semantic cache ----------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VERIFIER_MODEL=cross-encoder/nli-deberta-v3-base
CACHE_CONFIG_FILE=artifacts/cache/thresholds.json   # validation-selected retrieval/verifier thresholds
ML_DEVICE=auto                 # auto | cuda | cpu

# --- storage / keys ------------------------------------------------------------------
NANOGATE_DATA_DIR=var          # SQLite DB, receipt HMAC key, API-key pepper (all mode 0600)
NANOGATE_DB=var/nanogate.db
STORE_RAW_PROMPTS=false        # raw prompts are never stored unless this AND the policy allow it

# --- policy / pricing / scenario -------------------------------------------------------
POLICIES_FILE=config/policies.yaml
PRICING_FILE=config/pricing.yaml
SCENARIO_FILE=config/scenario.yaml
ROUTER_ARTIFACT_DIR=artifacts/router

# --- server ------------------------------------------------------------------------------
NANOGATE_HOST=127.0.0.1
NANOGATE_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_PROMPT_CHARS=32000

# --- model / data caches -----------------------------------------------------------------
HF_HOME=.runtime/hf            # LLM, embedding + verifier weights (offline after first download)
